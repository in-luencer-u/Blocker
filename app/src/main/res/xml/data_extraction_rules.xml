<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred. Protection history, the partner seed and
  the lockdown state must not be restorable onto another device, and the user's
  private statistics must never leave the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
